<mvc:View
    controllerName="zprogmini.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%"
>
    <ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        useIconTabBar="true"
        class="customObjectPage"
        upperCaseAnchorBar="false"
        headerContentPinnable="false"
        showAnchorBar="true"
        enableLazyLoading="false"
    >
        <!-- ================================================== -->
        <!-- 상단 제목 -->
        <!-- ================================================== -->

        <headerTitle>
            <ObjectPageDynamicHeaderTitle class="topHeader">
                <expandedHeading>
                    <m:HBox>
                        <m:Image
                            alt="가게 이미지"
                            src="{imgUrl}"
                            width="113px"
                            height="91px"
                            class="resImg"
                            mode="Background"
                            backgroundPosition="center"
                            backgroundSize="cover"
                            press="backNav"
                        />

                        <m:VBox justifyContent="Center">
                            <m:Text
                                text="{name}"
                                class="detailPageTitle"
                            />

                            <m:HBox class="">
                                <m:Text
                                    text="{category}"
                                    class="tag"
                                />
                                <m:Text
                                    text="{genre}"
                                    class="tag"
                                />
                            </m:HBox>
                        </m:VBox>
                    </m:HBox>
                </expandedHeading>
                <actions />

                <snappedHeading>
                    <m:HBox>
                        <m:Image
                            alt="가게 이미지"
                            src="{imgUrl}"
                            width="113px"
                            height="91px"
                            class="resImg"
                            mode="Background"
                            backgroundPosition="center"
                            backgroundSize="cover"
                            press="backNav"
                        />

                        <m:VBox justifyContent="Center">
                            <m:Text
                                text="{name}"
                                class="detailPageTitle"
                            />

                            <m:HBox class="">
                                <m:Text
                                    text="{category}"
                                    class="tag"
                                />
                                <m:Text
                                    text="{genre}"
                                    class="tag"
                                />
                            </m:HBox>
                        </m:VBox>
                    </m:HBox>
                </snappedHeading>

                <actions>
                    <m:Button
                        text="찜하기"
                        icon="{= ${isFavorite} ? '../images/favorite_heart_pulse.gif' : 'sap-icon://unfavorite'}"
                        id="idButtonFavorite"
                        class="actionButton"
                        activeIcon="../images/favorite_heart_burst.gif"
                        press=".onPressFavorite"
                    />
                    <m:Button
                        text="공유하기"
                        icon="sap-icon://share-2"
                        class="actionButton"
                        id="idButtonShare"
                        press=".onPressShare"
                    />
                </actions>
            </ObjectPageDynamicHeaderTitle>
        </headerTitle>

        <!-- ================================================== -->
        <!-- 가게 상단 정보 -->
        <!-- ================================================== -->

        <headerContent>
            <m:HBox
                justifyContent="SpaceBetween"
                class="restaurantHeader"
            >
                <!-- ============================== -->
                <!-- 가게 이미지 -->
                <!-- ============================== -->

                <m:HBox class="gap47px">
                    <m:Carousel
                        id="idCarousel"
                        width="466px"
                        height="282px"
                        showPageIndicator="false"
                        loop="true"
                        pages="{Menu}"
                    >
                        <m:Image
                            src="{imgUrl}"
                            width="466px"
                            height="282px"
                            class="restaurantMainImage"
                            mode="Background"
                            backgroundSize="cover"
                            backgroundPosition="center"
                        />
                    </m:Carousel>
                    <!-- ============================== -->
                    <!-- 가운데 가게 정보 -->
                    <!-- ============================== -->

                    <m:VBox
                        class="restaurantMainInfo"
                        justifyContent="Start"
                        alignItems="Start"
                        gap="11px"
                    >
                        <!-- 카테고리 -->
                        <m:HBox class="categoryBox">
                            <m:Text
                                text="{category}"
                                class="categoryText"
                            />
                            <m:Image
                                src="../images/VectorRight.png"
                                width="4.5px"
                            />
                            <m:Text
                                text="{genre}"
                                class="categoryText"
                            />
                        </m:HBox>

                        <!-- 가게 이름 -->
                        <m:Text
                            text="{name}"
                            class="restaurantName"
                        />

                        <!-- 리뷰 별점 -->
                        <m:HBox
                            class="mainMenuInfo"
                            gap="12px"
                            alignItems="End"
                        >
                            <m:Image
                                src="../images/Rating_star.png"
                                width="35px"
                                height="35px"
                            />
                            <m:Text
                                class="ratingText"
                                text="{
                            path: 'detailReview>/',
                            formatter: '.formatter.averageRating'
                        }"
                            />

                            <m:Text
                                text="{= '(' + ${detailReview>/}.length + '개의 리뷰)'}"
                                class="headerReviewCountText"
                            />
                        </m:HBox>
                        <m:Text
                            text="{detailReview>/0/content}"
                            class="fontSize20"
                        />
                        <m:HBox gap="14px">
                            <m:Button
                                text="찜하기"
                                icon="{= ${isFavorite} ? '../images/favorite_heart_pulse.gif' : 'sap-icon://unfavorite'}"
                                id="idButtonFavorit2e"
                                class="actionButton"
                                activeIcon="../images/favorite_heart_pop.gif"
                                press=".onPressFavorite"
                                type="Transparent"
                            />
                            <m:Button
                                text="공유하기"
                                icon="sap-icon://share-2"
                                class="actionButton"
                                id="idButtonShare2"
                                type="Transparent"
                                press="onPressShare"
                            />
                        </m:HBox>
                    </m:VBox>
                </m:HBox>
                <!-- ============================== -->
                <!-- 지도 -->
                <!-- ============================== -->

                <m:VBox
                    id="idVBoxlocationInfo"
                    class="borderLeftGray"
                >
                    <m:Image
                        src="{
                        formatter : '.formatter.mapURI',
                        parts: [
                            {path: 'location>longitude'},
                            {path: 'location>latitude'}
                        ]}"
                        width="404px"
                        height="120px"
                        class="radius16"
                    />
                    <m:VBox
                        alignItems="Center"
                        class=""
                    >
                        <m:VBox
                            gap="15px"
                            alignItems="Start"
                        >
                            <m:HBox
                                gap="15px"
                                justifyContent="Start"
                                alignItems="Center"
                                class="marginLeft17px marginTop10px  "
                            >
                                <core:Icon
                                    color="#505968"
                                    src="sap-icon://map"
                                    size="25px"
                                />
                                <m:Text
                                    text="{location>roadAddress}"
                                    class="bold fontSize14 singleLine"
                                />
                            </m:HBox>
                            <m:HBox
                                gap="15px"
                                justifyContent="Start"
                                alignItems="Center"
                                class="marginLeft17px"
                            >
                                <core:Icon
                                    color="#505968"
                                    src="sap-icon://subway-train"
                                    size="25px"
                                />
                                <m:Text
                                    text="{location>transportInfo}"
                                    class="fontSize14 singleLine"
                                />
                            </m:HBox>
                            <m:HBox
                                gap="15px"
                                justifyContent="Start"
                                alignItems="Center"
                                class="marginLeft17px"
                            >
                                <core:Icon
                                    color="#505968"
                                    src="sap-icon://call"
                                    size="25px"
                                />
                                <m:Text
                                    text="{phoneNumber}"
                                    class="fontSize14 singleLine"
                                />
                            </m:HBox>
                            <m:HBox
                                gap="15px"
                                justifyContent="Start"
                                alignItems="Center"
                                class="marginLeft17px"
                            >
                                <core:Icon
                                    color="#505968"
                                    src="sap-icon://pending"
                                    size="25px"
                                />
                                <m:Text
                                    text="{= '평일 ' + ${open} + ' ~ ' + ${close}}"
                                    class="fontSize14 singleLine"
                                />
                                <m:Button
                                    type="Accept"
                                    text="영업중"
                                    visible="{
                                parts: [
                                 {path : 'open'},{path : 'close'}
                                ],
                                formatter: '.formatter.isStoreOpen'
                            }"
                                />

                                <m:Button
                                    type="Reject"
                                    text="영업 준비중"
                                    visible="{
                                parts: [
                                 {path : 'open'},{path : 'close'}
                                ],
                                formatter: '.formatter.isStoreClosed'
                            }"
                                />
                            </m:HBox>
                        </m:VBox>
                    </m:VBox>
                </m:VBox>
            </m:HBox>
        </headerContent>

        <!-- ================================================== -->
        <!-- 정보 -->
        <!-- ================================================== -->

        <sections>
            <ObjectPageSection
                id="infoSection"
                title="정보"
                titleUppercase="false"
            >
                <customAnchorBarButton>
                    <m:Button
                        text="가게 기본 정보"
                        icon="sap-icon://home"
                        class="sectionTab"
                    />
                </customAnchorBarButton>
                <subSections>
                    <ObjectPageSubSection
                        title="가게 기본 정보"
                        titleUppercase="false"
                    >
                        <blocks>
                            <m:HBox
                                class="infoReviewContainer"
                                justifyContent="Center"
                                alignItems="Start"
                                width="100%"
                            >
                                <!-- 왼쪽 : 가게 정보 -->
                                <m:Panel class="infoPanel">
                                    <m:VBox>
                                        <m:Title
                                            text="가게 기본 정보"
                                            level="H2"
                                        />

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="카테고리 : " />
                                            <m:Text text="{category}" />
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="대표 음식 : " />
                                            <m:Text text="{signatureMenu}" />
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow imageRow">
                                            <m:Image
                                                src="{imgUrl}"
                                                width="300px"
                                                height="200px"
                                            />
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="거리 : " />
                                            <m:Text text="{distance}km" />
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="영업시간 : " />
                                            <m:Text text="{open} ~ {close}" />
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="전화번호 : " />
                                            <m:Text text="{phoneNumber}" />
                                        </m:HBox>
                                    </m:VBox>
                                </m:Panel>

                                <!-- 오른쪽 : 리뷰 / 별점 -->
                                <m:Panel class="reviewSummaryPanel">
                                    <m:VBox>
                                        <!-- 헤더 -->
                                        <m:HBox
                                            alignItems="Center"
                                            class="summaryHeader"
                                        >
                                            <core:Icon
                                                src="sap-icon://thumb-up"
                                                color="#E6A100"
                                                size="1.25rem"
                                            />
                                            <m:Title
                                                text="대표 리뷰"
                                                level="H4"
                                                class="summaryTitle"
                                            />
                                        </m:HBox>
                                        <m:Text
                                            text="만점(5점)을 받은 리뷰예요"
                                            class="summarySubText"
                                        />

                                        <!-- 5점 리뷰 목록 -->
                                        <m:List
                                            items="{
                                                path: 'detailReview>/',
                                                filters: [{ path: 'scope', operator: 'GE', value1: 4 }]
                                            }"
                                            showSeparators="None"
                                            backgroundDesign="Transparent"
                                            noDataText="아직 만점 리뷰가 없습니다"
                                        >
                                            <m:CustomListItem
                                                class="summaryCard"
                                            >
                                                <m:VBox
                                                    class="summaryCardInner"
                                                >
                                                    <!-- 메뉴명 + 별점 -->
                                                    <m:HBox
                                                        justifyContent="SpaceBetween"
                                                        alignItems="Center"
                                                    >
                                                        <m:Text
                                                            text="{detailReview>menuId}"
                                                            class="summaryMenu"
                                                        />
                                                        <m:RatingIndicator
                                                            value="{detailReview>scope}"
                                                            maxValue="5"
                                                            iconSize="0.9rem"
                                                            editable="false"
                                                        />
                                                    </m:HBox>

                                                    <!-- 리뷰 내용 (비어 있으면 숨김) -->
                                                    <m:Text
                                                        text="{detailReview>content}"
                                                        visible="{= !!${detailReview>content} }"
                                                        wrapping="true"
                                                        class="summaryText"
                                                    />
                                                </m:VBox>
                                            </m:CustomListItem>
                                        </m:List>
                                    </m:VBox>
                                </m:Panel>
                            </m:HBox>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>

            <!-- ================================================== -->
            <!-- 메뉴 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="menuSection"
                title="메뉴"
                titleUppercase="false"
            >
                <customAnchorBarButton>
                    <m:Button
                        text="메뉴"
                        icon="sap-icon://meal"
                        class="sectionTab"
                    />
                </customAnchorBarButton>
                <subSections>
                    <ObjectPageSubSection
                        title="메뉴"
                        titleUppercase="false"
                    >
                        <blocks>
                            <m:VBox
                                width="100%"
                                class="menuContainer"
                            >
                                <!-- 메뉴 제목 -->
                                <m:HBox
                                    alignItems="Center"
                                    class="menuHeader"
                                />

                                <!-- 메뉴 카드 -->
                                <layout:Grid
                                    defaultSpan="XL4 L4 M6 S12"
                                    hSpacing="1"
                                    vSpacing="1"
                                    width="100%"
                                    content="{Menu}"
                                >
                                    <m:VBox class="menuCard">
                                        <!-- 음식 이미지 -->
                                        <m:Image
                                            src="{imgUrl}"
                                            width="100%"
                                            height="320px"
                                            class="radius16"
                                            densityAware="false"
                                            mode="Background"
                                            backgroundSize="cover"
                                            backgroundPosition="center"
                                        />

                                        <!-- 메뉴 이름 -->
                                        <m:Title
                                            text="{name}"
                                            level="H3"
                                            class="menuName"
                                        />

                                        <!-- 가격 -->
                                        <m:Title
                                            text="{price}원"
                                            level="H3"
                                            class="menuPrice"
                                        />
                                    </m:VBox>
                                </layout:Grid>
                            </m:VBox>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>

            <!-- ================================================== -->
            <!-- 리뷰 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="reviewSection"
                title="리뷰"
                titleUppercase="false"
            >
                <customAnchorBarButton>
                    <m:Button
                        text="리뷰"
                        icon="sap-icon://discussion-2"
                        class="sectionTab"
                    />
                </customAnchorBarButton>

                <subSections>
                    <ObjectPageSubSection
                        title="리뷰 요약"
                        titleUppercase="false"
                    >
                        <blocks>
                            <m:HBox
                                width="100%"
                                justifyContent="SpaceBetween"
                            >
                                <m:VBox
                                    width="65%"
                                    class="reviewContentPanel"
                                >
                                    <m:List
                                        id="idReviewList"
                                        items="{detailReview>/}"
                                        showSeparators="None"
                                        backgroundDesign="Transparent"
                                        noDataText="아직 작성된 리뷰가 없습니다"
                                    >
                                        <m:CustomListItem class="reviewCard">
                                            <m:VBox class="reviewItem">
                                                <!-- 상단: 메뉴명 + 날짜 -->
                                                <m:HBox
                                                    justifyContent="SpaceBetween"
                                                    alignItems="Center"
                                                >
                                                    <m:Title
                                                        text="{review>menuId}"
                                                        level="H4"
                                                        class="reviewMenuTitle"
                                                    />
                                                    <m:Text
                                                        text="{= ${detailReview>date}.substring(0, 10) }"
                                                        class="reviewDate"
                                                    />
                                                </m:HBox>

                                                <!-- 별점 + 점수 -->
                                                <m:HBox
                                                    alignItems="Center"
                                                    class="reviewRatingRow"
                                                >
                                                    <m:RatingIndicator
                                                        value="{detailReview>scope}"
                                                        maxValue="5"
                                                        iconSize="1rem"
                                                        editable="false"
                                                    />
                                                    <m:Text
                                                        text="{detailReview>scope} / 5"
                                                        class="reviewScore"
                                                    />
                                                </m:HBox>

                                                <!-- 태그: 재방문 / 웨이팅 -->
                                                <m:HBox class="reviewTagRow">
                                                    <m:ObjectStatus
                                                        text="{= ${detailReview>revisit} ? '재방문 의사 있음' : '재방문 의사 없음' }"
                                                        state="{= ${detailReview>revisit} ? 'Success' : 'Error' }"
                                                        inverted="true"
                                                        class="reviewTag"
                                                    />
                                                    <m:ObjectStatus
                                                        text="{= ${detailReview>waiting} ? '웨이팅 있음' : '웨이팅 없음' }"
                                                        state="{= ${detailReview>waiting} ? 'Warning' : 'Information' }"
                                                        inverted="true"
                                                        class="reviewTag"
                                                    />
                                                </m:HBox>

                                                <m:Text
                                                    text="메뉴 : {detailReview>menuId}"
                                                    visible="{= !!${detailReview>menuId} }"
                                                    wrapping="true"
                                                    class="summaryMenu"
                                                />

                                                <!-- 사진 (이미지 경로가 있을 때만 표시) -->
                                                <m:Image
                                                    src="{detailReview>imgUrl}"
                                                    visible="{= !!${detailReview>imgUrl} }"
                                                    width="50%"
                                                    height="240px"
                                                    densityAware="false"
                                                    class="reviewImage"
                                                />

                                                <!-- 리뷰 내용 (비어 있으면 숨김) -->
                                                <m:Text
                                                    text="{detailReview>content}"
                                                    visible="{= !!${detailReview>content} }"
                                                    wrapping="true"
                                                    class="reviewText"
                                                />
                                                <m:Button
                                                    text="선택한 리뷰 삭제"
                                                    icon="sap-icon://delete"
                                                    type="Reject"
                                                    press=".onDeleteReview"
                                                />
                                            </m:VBox>
                                        </m:CustomListItem>
                                    </m:List>
                                </m:VBox>
                            </m:HBox>
                        </blocks>
                    </ObjectPageSubSection>
                </subSections>
            </ObjectPageSection>
        </sections>
    </ObjectPageLayout>
</mvc:View>
