<mvc:View
    controllerName="zprogmini.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%">

    <ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        useIconTabBar="true"
        class="customObjectPage border"
        upperCaseAnchorBar="false"
        showAnchorBar="true"
        enableLazyLoading="false">

        <!-- ================================================== -->
        <!-- 상단 제목 -->
        <!-- ================================================== -->

        
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>

                <expandedHeading>
                    <m:HBox alignItems="Center">
                        <core:Icon src="sap-icon://home"/>
                        <m:Button
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            press="backNav"/>

                        <m:Text
                            text="맛집 상세"
                            class="detailPageTitle"/>

                    </m:HBox>
                </expandedHeading>

                <snappedHeading>
                    <m:Title
                        text="{Menu>/name}"/>
                </snappedHeading>

                <actions>

                    <m:Button
                        text="즐겨찾기"
                        icon="sap-icon://bookmark"
                        type="Transparent"/>

                </actions>

            </ObjectPageDynamicHeaderTitle>
        </headerTitle>


        <!-- ================================================== -->
        <!-- 가게 상단 정보 -->
        <!-- ================================================== -->

        <headerContent>

            <m:HBox
                width="100%"
                alignItems="Center"
                justifyContent="SpaceBetween"
                class="restaurantHeader">


                <!-- ============================== -->
                <!-- 가게 이미지 -->
                <!-- ============================== -->

                <m:VBox width="38%">

                    <m:Image
                        src="{Menu>/_review/0/image}"
                        width="100%"
                        height="250px"
                        densityAware="false"
                        decorative="false"
                        class="restaurantMainImage"/>

                </m:VBox>


                <!-- ============================== -->
                <!-- 가운데 가게 정보 -->
                <!-- ============================== -->

                <m:VBox
                    width="42%"
                    class="restaurantMainInfo">

                    <!-- 카테고리 -->
                    <m:HBox
                        alignItems="Center"
                        class="categoryBox">

                        <m:ObjectStatus
                            text="{Menu>Category}"
                            state="Information"
                            class="categoryStatus"/>

                        <m:ObjectStatus
                            text="{Menu>menuGenre}"
                            state="None"
                            class="genreStatus"/>

                    </m:HBox>


                    <!-- 가게 이름 -->
                    <m:Title
                        text="{Menu>/name}"
                        level="H1"
                        class="restaurantName"/>


                    <!-- 대표 메뉴 -->
                    <m:HBox
                        alignItems="Center"
                        class="mainMenuInfo">

                        <core:Icon
                            src="sap-icon://meal"
                            size="24px"/>

                        <m:Text
                            text="대표 메뉴"
                            class="mainMenuLabel"/>

                        <m:Text
                            text="{Menu>/_review/0/menuName}"
                            class="mainMenuName"/>

                    </m:HBox>


                    <!-- 거리 / 영업시간 / 전화번호 -->
                    <m:HBox
                        alignItems="Center"
                        class="restaurantBasicInfo">

                        <!-- 거리 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://map"
                                size="18px"/>

                            <m:Text
                                text="{Menu>distance}m"/>

                        </m:HBox>


                        <m:Text text="|" class="infoDivider"/>


                        <!-- 영업시간 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://history"
                                size="18px"/>

                            <m:Text
                                text="{Menu>/_review/0/open}"/>

                        </m:HBox>


                        <m:Text text="|" class="infoDivider"/>


                        <!-- 전화번호 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://call"
                                size="18px"/>

                            <m:Text
                                text="{Menu>/_review/0/number}"/>

                        </m:HBox>

                    </m:HBox>


                    <!-- 영업 중 -->
                    <m:ObjectStatus
                        text="영업 중"
                        state="Success"
                        class="openStatus"/>

                </m:VBox>


                <!-- ============================== -->
                <!-- 즐겨찾기 -->
                <!-- ============================== -->

                <m:VBox
                    width="15%"
                    alignItems="End">

                    <m:Button
                        text="즐겨찾기"
                        icon="sap-icon://bookmark"
                        type="Default"
                        class="favoriteButton"/>

                </m:VBox>

            </m:HBox>

        </headerContent>


        <!-- ================================================== -->
        <!-- 정보 -->
        <!-- ================================================== -->

        <sections>

            <ObjectPageSection
                id="infoSection"
                title="가게 정보"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="가게 기본 정보"
                        titleUppercase="false">

                        <blocks>

                            <m:Panel
                                class="infoPanel">

                                <m:VBox>

                                    <m:Title
                                        text="가게 기본 정보"
                                        level="H2"/>


                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="카테고리 : "/>
                                        <m:Text text=" {Menu>/category}"/>

                                    </m:HBox>


                                    <!-- <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="음식 종류"/>
                                        <m:Text text="{Menu>menuGenre}"/>

                                    </m:HBox> -->


                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="대표 음식 : "/>
                                        <m:Text
                                            text=" {Menu>/signatureMenu}"/>
                                    </m:HBox>

                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="대표 이미지 "/>
                                        <m:Image src=" {Menu>/imgUrl}" width="300px" height="200px"/>

                                    </m:HBox>


                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="거리 : "/>
                                        <m:Text
                                            text=" {Menu>/distance}m"/>

                                    </m:HBox>


                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="영업시간 : "/>
                                        <m:Text
                                            text=" {Menu>/open}~{Menu>/close}"/>

                                    </m:HBox>


                                    <m:HBox
                                        class="infoDetailRow">

                                        <m:Label text="전화번호 : "/>
                                        <m:Text
                                            text=" {Menu>/phoneNumber}"/>

                                    </m:HBox>

                                </m:VBox>

                            </m:Panel>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>


            <!-- ================================================== -->
            <!-- 메뉴 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="menuSection"
                title="메뉴"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="메뉴"
                        titleUppercase="false">

                        <blocks>

                            <m:VBox
                                width="100%"
                                class="menuContainer">

                                <!-- 메뉴 제목 -->
                                <m:HBox
                                    alignItems="Center"
                                    class="menuHeader">

                                    <core:Icon
                                        src="sap-icon://meal"
                                        size="25px"/>

                                    <m:Title
                                        text="메뉴"
                                        level="H2"/>

                                </m:HBox>


                                <!-- 메뉴 카드 -->
                                <layout:Grid
                                    defaultSpan="XL4 L4 M6 S12"
                                    hSpacing="1"
                                    vSpacing="1"
                                    width="100%"
                                    content="{Menu>/Menu}">

                                    <m:VBox
                                        class="menuCard">

                                        <!-- 음식 이미지 -->
                                        <m:Image
                                            src="{Menu>imgUrl}"
                                            width="100%"
                                            height="160px"
                                            densityAware="false"/>


                                        <!-- 메뉴 이름 -->
                                        <m:Title
                                            text="{Menu>name}"
                                            level="H3"
                                            class="menuName"/>


                                        <!-- 가격 -->
                                        <m:Title
                                            text="{Menu>price}"
                                            level="H3"
                                            class="menuPrice"/>

                                    </m:VBox>

                                </layout:Grid>

                            </m:VBox>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>


            <!-- ================================================== -->
            <!-- 리뷰 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="reviewSection"
                title="리뷰"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="리뷰 요약"
                        titleUppercase="false">

                        <blocks>

                            <m:HBox
                                width="100%"
                                justifyContent="SpaceBetween">


                                <!-- 리뷰 점수 -->
                                <m:VBox
                                    width="30%"
                                    class="reviewSummaryPanel">

                                    <m:Title
                                        text="리뷰 요약"
                                        level="H2"/>

                                    <m:HBox
                                        alignItems="Center"
                                        class="ratingArea">

                                        <core:Icon
                                            src="sap-icon://favorite"
                                            size="40px"
                                            color="#FFD400"/>

                                        <m:Title
                                            text="{Menu>/scope}"
                                            level="H1"/>

                                        <m:Text
                                            text=" / 5.0"/>

                                    </m:HBox>

                                </m:VBox>


                                <!-- 리뷰 내용 -->
                                <m:VBox
                                    width="65%"
                                    class="reviewContentPanel">

                                    <m:List
                                        items="{Menu>/_review}">

                                        <m:CustomListItem>

                                            <m:VBox
                                                class="reviewItem">

                                                <m:HBox
                                                    justifyContent="SpaceBetween">

                                                    <m:Title
                                                        text="맛집 리뷰"
                                                        level="H4"/>

                                                    <m:ObjectStatus
                                                        text="{Menu>Waiting}"
                                                        state="None"/>

                                                </m:HBox>


                                                <m:HBox
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://favorite"
                                                        color="#FFD400"/>

                                                    <m:Text
                                                        text="{Menu>/scope}"
                                                        class="reviewScore"/>

                                                </m:HBox>


                                                <m:Text
                                                    text="{Menu>review}"
                                                    wrapping="true"
                                                    class="reviewText"/>

                                            </m:VBox>

                                        </m:CustomListItem>

                                    </m:List>

                                </m:VBox>

                            </m:HBox>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>

        </sections>

    </ObjectPageLayout>

</mvc:View>