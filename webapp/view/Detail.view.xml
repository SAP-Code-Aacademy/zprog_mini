<mvc:View
    controllerName="zprogmini.controller.Detail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.uxap"
    xmlns:m="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:core="sap.ui.core"
    height="100%">

    <ObjectPageLayout
        id="ObjectPageLayout"
        showTitleInHeaderContent="true"
        useIconTabBar="true"
        class="customObjectPage border"
        upperCaseAnchorBar="false"
        showAnchorBar="true"
        enableLazyLoading="false">

        <!-- ================================================== -->
        <!-- 상단 제목 -->
        <!-- ================================================== -->

        
        <headerTitle>
            <ObjectPageDynamicHeaderTitle>

                <expandedHeading>
                    <m:HBox alignItems="Center">
                        <core:Icon src="sap-icon://home"/>
                        <m:Button
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            press="backNav"/>

                        <m:Text
                            text="맛집 상세"
                            class="detailPageTitle"/>

                    </m:HBox>
                </expandedHeading>

                <snappedHeading>
                    <m:Title
                        text="{Menu>/name}"/>
                </snappedHeading>

                <actions>

                    <m:Button
                        text="즐겨찾기"
                        icon="sap-icon://bookmark"
                        type="Transparent"/>

                </actions>

            </ObjectPageDynamicHeaderTitle>
        </headerTitle>


        <!-- ================================================== -->
        <!-- 가게 상단 정보 -->
        <!-- ================================================== -->

        <headerContent>

            <m:HBox
                width="100%"
                alignItems="Center"
                justifyContent="SpaceBetween"
                class="restaurantHeader">


                <!-- ============================== -->
                <!-- 가게 이미지 -->
                <!-- ============================== -->

                <m:VBox width="38%">

                    <m:Image
                        src="{Menu>/_review/0/image}"
                        width="100%"
                        height="250px"
                        densityAware="false"
                        decorative="false"
                        class="restaurantMainImage"/>

                </m:VBox>


                <!-- ============================== -->
                <!-- 가운데 가게 정보 -->
                <!-- ============================== -->

                <m:VBox
                    width="42%"
                    class="restaurantMainInfo">

                    <!-- 카테고리 -->
                    <m:HBox
                        alignItems="Center"
                        class="categoryBox">

                        <m:ObjectStatus
                            text="{Menu>Category}"
                            state="Information"
                            class="categoryStatus"/>

                        <m:ObjectStatus
                            text="{Menu>menuGenre}"
                            state="None"
                            class="genreStatus"/>

                    </m:HBox>


                    <!-- 가게 이름 -->
                    <m:Title
                        text="{Menu>/name}"
                        level="H1"
                        class="restaurantName"/>


                    <!-- 대표 메뉴 -->
                    <m:HBox
                        alignItems="Center"
                        class="mainMenuInfo">

                        <core:Icon
                            src="sap-icon://meal"
                            size="24px"/>

                        <m:Text
                            text="대표 메뉴"
                            class="mainMenuLabel"/>

                        <m:Text
                            text="{Menu>/_review/0/menuName}"
                            class="mainMenuName"/>

                    </m:HBox>


                    <!-- 거리 / 영업시간 / 전화번호 -->
                    <m:HBox
                        alignItems="Center"
                        class="restaurantBasicInfo">

                        <!-- 거리 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://map"
                                size="18px"/>

                            <m:Text
                                text="{Menu>distance}m"/>

                        </m:HBox>


                        <m:Text text="|" class="infoDivider"/>


                        <!-- 영업시간 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://history"
                                size="18px"/>

                            <m:Text
                                text="{Menu>/_review/0/open}"/>

                        </m:HBox>


                        <m:Text text="|" class="infoDivider"/>


                        <!-- 전화번호 -->
                        <m:HBox alignItems="Center">

                            <core:Icon
                                src="sap-icon://call"
                                size="18px"/>

                            <m:Text
                                text="{Menu>/_review/0/number}"/>

                        </m:HBox>

                    </m:HBox>


                    <!-- 영업 중 -->
                    <m:ObjectStatus
                        text="영업 중"
                        state="Success"
                        class="openStatus"/>

                </m:VBox>


                <!-- ============================== -->
                <!-- 즐겨찾기 -->
                <!-- ============================== -->

                <m:VBox
                    width="15%"
                    alignItems="End">

                    <m:Button
                        text="즐겨찾기"
                        icon="sap-icon://bookmark"
                        type="Default"
                        class="favoriteButton"/>

                </m:VBox>

            </m:HBox>

        </headerContent>


        <!-- ================================================== -->
        <!-- 정보 -->
        <!-- ================================================== -->

        <sections>

            <ObjectPageSection
                id="infoSection"
                title="가게 정보"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="가게 기본 정보"
                        titleUppercase="false">

                        <blocks>

                            <m:HBox
                                class="infoReviewContainer"
                                justifyContent="Center"
                                alignItems="Start"
                                width="100%">

                                <!-- 왼쪽 : 가게 정보 -->
                                <m:Panel
                                    class="infoPanel">

                                    <m:VBox>

                                        <m:Title
                                            text="가게 기본 정보"
                                            level="H2"/>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="카테고리 : "/>
                                            <m:Text text="{category}"/>
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="대표 음식 : "/>
                                            <m:Text text="{signatureMenu}"/>
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow imageRow">
                                            <m:Image
                                                src="{imgUrl}"
                                                width="300px"
                                                height="200px"/>
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="거리 : "/>
                                            <m:Text text="{distance}km"/>
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="영업시간 : "/>
                                            <m:Text text="{open} ~ {close}"/>
                                        </m:HBox>

                                        <m:HBox class="infoDetailRow">
                                            <m:Label text="전화번호 : "/>
                                            <m:Text text="{phoneNumber}"/>
                                        </m:HBox>

                                    </m:VBox>

                                </m:Panel>


                                <!-- 오른쪽 : 리뷰 / 별점 -->
                                <m:Panel class="reviewSummaryPanel">

                                    <m:VBox>

                                        <!-- 헤더 -->
                                        <m:HBox alignItems="Center" class="summaryHeader">
                                            <core:Icon src="sap-icon://thumb-up" color="#E6A100" size="1.25rem"/>
                                            <m:Title text="대표 리뷰" level="H4" class="summaryTitle"/>
                                        </m:HBox>
                                        <m:Text text="만점(5점)을 받은 리뷰예요" class="summarySubText"/>

                                        <!-- 5점 리뷰 목록 -->
                                        <m:List
                                            items="{
                                                path: 'detailReview>/',
                                                filters: [{ path: 'scope', operator: 'GE', value1: 4 }]
                                            }"
                                            showSeparators="None"
                                            backgroundDesign="Transparent"
                                            noDataText="아직 만점 리뷰가 없습니다">

                                            <m:CustomListItem class="summaryCard">
                                                <m:VBox class="summaryCardInner">

                                                    <!-- 메뉴명 + 별점 -->
                                                    <m:HBox justifyContent="SpaceBetween" alignItems="Center">
                                                        <m:Text text="{detailReview>menuId}" class="summaryMenu"/>
                                                        <m:RatingIndicator
                                                            value="{detailReview>scope}"
                                                            maxValue="5"
                                                            iconSize="0.9rem"
                                                            editable="false"/>
                                                    </m:HBox>

                                                    <!-- 리뷰 내용 (비어 있으면 숨김) -->
                                                    <m:Text
                                                        text="{detailReview>content}"
                                                        visible="{= !!${detailReview>content} }"
                                                        wrapping="true"
                                                        class="summaryText"/>

                                                </m:VBox>
                                            </m:CustomListItem>

                                        </m:List>

                                    </m:VBox>

                                </m:Panel>

                            </m:HBox>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>



            <!-- ================================================== -->
            <!-- 메뉴 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="menuSection"
                title="메뉴"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="메뉴"
                        titleUppercase="false">

                        <blocks>

                            <m:VBox
                                width="100%"
                                class="menuContainer">

                                <!-- 메뉴 제목 -->
                                <m:HBox
                                    alignItems="Center"
                                    class="menuHeader">

                                    <core:Icon
                                        src="sap-icon://meal"
                                        size="25px"/>

                                    <m:Title
                                        text="메뉴"
                                        level="H2"/>

                                </m:HBox>


                                <!-- 메뉴 카드 -->
                                <layout:Grid
                                    defaultSpan="XL4 L4 M6 S12"
                                    hSpacing="1"
                                    vSpacing="1"
                                    width="100%"
                                    content="{Menu}">

                                    <m:VBox
                                        class="menuCard">

                                        <!-- 음식 이미지 -->
                                        <m:Image
                                            src="{imgUrl}"
                                            width="100%"
                                            height="160px"
                                            densityAware="false"/>


                                        <!-- 메뉴 이름 -->
                                        <m:Title
                                            text="{name}"
                                            level="H3"
                                            class="menuName"/>


                                        <!-- 가격 -->
                                        <m:Title
                                            text="{price}원"
                                            level="H3"
                                            class="menuPrice"/>

                                    </m:VBox>

                                </layout:Grid>

                            </m:VBox>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>


            <!-- ================================================== -->
            <!-- 리뷰 -->
            <!-- ================================================== -->

            <ObjectPageSection
                id="reviewSection"
                title="리뷰"
                titleUppercase="false">

                <subSections>

                    <ObjectPageSubSection
                        title="리뷰 요약"
                        titleUppercase="false">

                        <blocks>

                            <m:HBox
                                width="100%"
                                justifyContent="SpaceBetween">

                                <m:VBox width="65%" class="reviewContentPanel">

                                    <m:List
                                        items="{detailReview>/}"
                                        showSeparators="None"
                                        backgroundDesign="Transparent"
                                        noDataText="아직 작성된 리뷰가 없습니다">

                                        <m:CustomListItem class="reviewCard">
                                            <m:VBox class="reviewItem">

                                                <!-- 상단: 메뉴명 + 날짜 -->
                                                <m:HBox justifyContent="SpaceBetween" alignItems="Center">
                                                    <m:Title text="{review>menuId}" level="H4" class="reviewMenuTitle"/>
                                                    <m:Text text="{= ${detailReview>date}.substring(0, 10) }" class="reviewDate"/>
                                                </m:HBox>

                                                <!-- 별점 + 점수 -->
                                                <m:HBox alignItems="Center" class="reviewRatingRow">
                                                    <m:RatingIndicator
                                                        value="{detailReview>scope}"
                                                        maxValue="5"
                                                        iconSize="1rem"
                                                        editable="false"/>
                                                    <m:Text text="{detailReview>scope} / 5" class="reviewScore"/>
                                                </m:HBox>

                                                <!-- 태그: 재방문 / 웨이팅 -->
                                                <m:HBox class="reviewTagRow">
                                                    <m:ObjectStatus
                                                        text="{= ${detailReview>revisit} ? '재방문 의사 있음' : '재방문 의사 없음' }"
                                                        state="{= ${detailReview>revisit} ? 'Success' : 'Error' }"
                                                        inverted="true"
                                                        class="reviewTag"/>
                                                    <m:ObjectStatus
                                                        text="{= ${detailReview>waiting} ? '웨이팅 있음' : '웨이팅 없음' }"
                                                        state="{= ${detailReview>waiting} ? 'Warning' : 'Information' }"
                                                        inverted="true"
                                                        class="reviewTag"/>
                                                </m:HBox>

                                                <m:Text
                                                    text="메뉴 : {detailReview>menuId}"
                                                    visible="{= !!${detailReview>menuId} }"
                                                    wrapping="true"
                                                    class="summaryMenu"/>

                                                <!-- 사진 (이미지 경로가 있을 때만 표시) -->
                                                <m:Image
                                                    src="{detailReview>imgUrl}"
                                                    visible="{= !!${detailReview>imgUrl} }"
                                                    width="50%"
                                                    height="180px"
                                                    densityAware="false"
                                                    class="reviewImage"/>

                                                <!-- 리뷰 내용 (비어 있으면 숨김) -->
                                                <m:Text
                                                    text="{detailReview>content}"
                                                    visible="{= !!${detailReview>content} }"
                                                    wrapping="true"
                                                    class="reviewText"/>

                                            </m:VBox>
                                        </m:CustomListItem>

                                    </m:List>
                                </m:VBox>

                            </m:HBox>

                        </blocks>

                    </ObjectPageSubSection>

                </subSections>

            </ObjectPageSection>

        </sections>

    </ObjectPageLayout>

</mvc:View>